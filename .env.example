# ==========================================
# ADRENALINE AQUA - ENVIRONMENT CONFIGURATION
# ==========================================
# Copy this file to '.env' and fill in your actual credentials.

# ------------------------------------------
# Supabase Configuration
# ------------------------------------------
# Your Supabase project URL and public anon key
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ------------------------------------------
# AI Insights & Groq API
# ------------------------------------------
# Groq API key for AI-driven business intelligence, route pacing, and recommendations
VITE_GROQ_API_KEY=gsk_your_groq_api_key_here

# ------------------------------------------
# Maps & Geolocation (Optional)
# ------------------------------------------
# Google Maps JavaScript API key for delivery routing and stop mapping
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ------------------------------------------
# AI Backend Server
# ------------------------------------------
PORT=5000
